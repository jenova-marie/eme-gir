# Bulk data — large, regenerable from oracc.museum.upenn.edu
*.zip
*.sqlite*

# Logs
*.log

# Generated reports + runtime sentinels under data/
data/missing_corpora.json
data/.initialized

# Per-deployment env files — Auth0 tenant URLs, audiences, allowed
